# API credentials for the voice gateway. Uncomment the variables you need.
# Windows setup preserves this file beside the installed executable.
# macOS: voice-gateway -env-file ~/.config/voice-gateway/voice-gateway.env
# systemd: copy beside voice-gateway.service to ~/.config/systemd/user/voice-gateway.env with permissions 0600.
# With -env-file, file values override inherited variables for this process only.

# The standalone gateway probes genai providers at startup and hides unavailable
# choices with a warning.

# Alibaba (provider = "alibaba"):
# DASHSCOPE_API_KEY_INTL="replace-with-your-dashscope-key"
# DASHSCOPE_API_KEY_US="replace-with-your-dashscope-key"

# Anthropic (provider = "anthropic"):
# ANTHROPIC_API_KEY="replace-with-your-anthropic-key"

# Cerebras (provider = "cerebras"):
# CEREBRAS_API_KEY="replace-with-your-cerebras-key"

# Codex subscription (provider = "openai", auth = "codex"):
# Reads the gateway user's existing ~/.codex/auth.json; no API key is needed.
# Sign in with codex login as the gateway user. If using keyring storage, set
# cli_auth_credentials_store = "file" in Codex config.toml before signing in.
# Tokens renew automatically; restart the gateway after switching user/workspace.
# Defaults to ~/.codex; a leading ~ is expanded by the gateway:
# CODEX_HOME="~/.codex"

# Cohere (provider = "cohere"):
# COHERE_API_KEY="replace-with-your-cohere-key"

# DeepSeek (provider = "deepseek" in [[llm]]):
# DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Gemini Live and chat (provider = "gemini"):
# GEMINI_API_KEY="replace-with-your-gemini-key"

# Groq (provider = "groq"):
# GROQ_API_KEY="replace-with-your-groq-key"

# Mistral (provider = "mistral"):
# MISTRAL_API_KEY="replace-with-your-mistral-key"

# OpenAI Realtime and chat (provider = "openai"):
# OPENAI_API_KEY="replace-with-your-openai-key"

# OpenRouter (provider = "openrouter"):
# OPENROUTER_API_KEY="replace-with-your-openrouter-key"

# Together AI (provider = "togetherai"):
# TOGETHER_API_KEY="replace-with-your-together-key"

# Custom OpenAI-compatible endpoint:
# The variable name must match api_key_name on [[llm]].
# REMOTE_LLM_API_KEY=replace-with-your-remote-llm-key
