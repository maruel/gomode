# API credentials for the voice gateway systemd user service.
# Copy beside voice-gateway.service to ~/.config/systemd/user/voice-gateway.env with permissions 0600.
# Uncomment and fill in only the keys needed by your configured choices.
# Use NAME=value assignments, without shell export commands or substitutions.

# Gemini Live (provider = "gemini" in [[realtime]]):
# GEMINI_API_KEY=replace-with-your-gemini-key

# OpenAI Realtime (provider = "openai" in [[realtime]]):
# OPENAI_API_KEY=replace-with-your-openai-key

# Native DeepSeek provider (provider = "deepseek" in [[chat]], or local_stack.llm):
# DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Custom OpenAI-compatible endpoint in contrib/config.toml:
# The variable name must match api_key_name on [[chat]] or local_stack.llm.
# REMOTE_LLM_API_KEY=replace-with-your-remote-llm-key
