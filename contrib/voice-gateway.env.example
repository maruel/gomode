# API credentials for the voice gateway systemd user service.
# Copy beside voice-gateway.service to ~/.config/systemd/user/voice-gateway.env with permissions 0600.
# Uncomment and fill in only the keys needed by your configured choices.
# Use NAME=value assignments, without shell export commands or substitutions.

# The standalone gateway probes genai providers at startup and hides unavailable
# choices with a warning. Restart after changing credentials. A configured key
# does not guarantee access to every model.

# Gemini Live and chat (provider = "gemini"):
# GEMINI_API_KEY=replace-with-your-gemini-key

# OpenAI Realtime and chat (provider = "openai", alias of "openairesponses"):
# OPENAI_API_KEY=replace-with-your-openai-key

# Native DeepSeek provider (provider = "deepseek" in [[chat]], or local_stack.llm):
# DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Other chat providers in contrib/config.toml (names from genai's registry):
# Alibaba (provider = "alibaba"):
# DASHSCOPE_API_KEY=replace-with-your-dashscope-key
# Anthropic (provider = "anthropic"):
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key
# Cerebras (provider = "cerebras"):
# CEREBRAS_API_KEY=replace-with-your-cerebras-key
# Cohere (provider = "cohere"):
# COHERE_API_KEY=replace-with-your-cohere-key
# Groq (provider = "groq"):
# GROQ_API_KEY=replace-with-your-groq-key
# Mistral (provider = "mistral"):
# MISTRAL_API_KEY=replace-with-your-mistral-key
# OpenRouter (provider = "openrouter"):
# OPENROUTER_API_KEY=replace-with-your-openrouter-key
# Together AI (provider = "togetherai"):
# TOGETHER_API_KEY=replace-with-your-together-key

# Custom OpenAI-compatible endpoint in contrib/config.toml:
# The variable name must match api_key_name on [[chat]] or local_stack.llm.
# REMOTE_LLM_API_KEY=replace-with-your-remote-llm-key
