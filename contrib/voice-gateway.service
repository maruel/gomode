# systemd user service for the standalone voice gateway.
[Unit]
Description=Go Mode voice gateway

[Service]
Type=exec
ExecStart=%h/.local/bin/voice-gateway
Environment="PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/.config/systemd/user/voice-gateway.env
# The current gateway catches SIGINT to close sessions before exiting.
KillSignal=SIGINT
TimeoutStopSec=30s
# Config or executable changes make the gateway exit successfully for restart.
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
