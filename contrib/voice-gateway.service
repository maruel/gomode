# Example systemd user service for the standalone voice gateway.
[Unit]
Description=Go Mode voice gateway

[Service]
Type=exec
ExecStartPre=/usr/bin/test -r %h/.config/voice-gateway/config.toml
ExecStart=%h/.local/bin/voice-gateway -config %h/.config/voice-gateway/config.toml
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin
# Optional for local-only deployments. See voice-gateway.env.example.
EnvironmentFile=-%h/.config/systemd/user/voice-gateway.env
# The current gateway catches SIGINT to close sessions before exiting.
KillSignal=SIGINT
TimeoutStopSec=30s
# Config or executable changes make the gateway exit successfully for restart.
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
